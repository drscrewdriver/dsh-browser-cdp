{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id": "dsh-browser-cdp",
  "name": "dsh-browser-cdp",
  "version": "1.7.1-rc.3",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "presentation.dsh/v1alpha1",
        "kind": "OpenExternal",
        "optional": true,
        "fallback": "report the URL as text instead of opening it"
      },
      {
        "apiVersion": "presentation.dsh/v1alpha1",
        "kind": "Notification",
        "optional": true,
        "fallback": "log the notice to the browser-status scene"
      }
    ]
  },
  "permissions": [],
  "contributes": {
    "commands": [],
    "x-dsh-tui": [
      {
        "apiVersion": "tui.dsh/v1alpha1",
        "kind": "Scene",
        "id": "dsh-browser-cdp.watch",
        "name": "agent_browser",
        "spec": {
          "title": "Agent 浏览器",
          "titles": {
            "en": "Agent Browser",
            "zh": "Agent 浏览器"
          }
        }
      },
      {
        "apiVersion": "tui.dsh/v1alpha1",
        "kind": "SettingsSection",
        "id": "dsh-browser-cdp.settings",
        "name": "dsh_browser_cdp_settings",
        "spec": {
          "namespace": "dsh-browser-cdp",
          "title": "Agent 浏览器",
          "titles": {
            "en": "Agent Browser",
            "zh": "Agent 浏览器"
          },
          "fields": [
            {
              "path": [
                "toolInjection"
              ],
              "label": "工具注入模式 (Tool injection mode)",
              "kind": "select",
              "options": [
                {
                  "value": "lazy",
                  "label": "lazy"
                },
                {
                  "value": "always",
                  "label": "always"
                }
              ],
              "hint": "lazy（默认）= 只常驻 1 个（bcdp_status，兼作解锁入口），其余首次 bcdp_* 调用后按下方开关注入，闲置回收时收回；always = 挂载即注册全部 34 个（历史行为）。"
            },
            {
              "path": [
                "toolBrowse"
              ],
              "label": "基础操作工具（19 个）",
              "kind": "boolean",
              "hint": "开（默认）= 浏览器活动后按 act → observe → wait 三波放行；关 = 19 个工具从模型工具列表移除（空间/导航/点击/填写/键鼠/拖拽/截图/读取/指南/预检/等待…）。"
            },
            {
              "path": [
                "toolExtended"
              ],
              "label": "扩展能力工具（8 个）",
              "kind": "boolean",
              "hint": "开（默认）= 浏览器活动后注册；关 = 8 个工具移除（裸 CDP/HTTP/上传/下载/对话框/验证码/登录落盘/登录导入）。"
            },
            {
              "path": [
                "toolEscape"
              ],
              "label": "逃生舱 script（1 个）",
              "kind": "boolean",
              "hint": "与其它非 core 档一样等浏览器活动（1.7.0 起不再有「始终可达」豁免）：先调 bcdp_status 即可拿到它，一个 heredoc 能做到其余大多数工具的事。关 = 封印。"
            },
            {
              "path": [
                "toolJudge"
              ],
              "label": "评审工具 bcdp_jev_*（5 个）",
              "kind": "boolean",
              "hint": "开仍需配了 JEV 或 Laya Key：没 Key 的评审工具只能回答「未配置」，依旧不注入。关 = 任何情况下都不注入。"
            },
            {
              "path": [
                "sessionScopedPulse"
              ],
              "label": "按会话隔离解锁 (Per-session unlock)",
              "kind": "boolean",
              "hint": "开（默认）= 每个会话各自调 bcdp_status 解锁，不会影响到其他会话；关 = 进程级共享（任一会话解锁对所有会话生效，历史行为）。宿主不支持时自动降级为关。"
            },
            {
              "path": [
                "isolateSpaces"
              ],
              "label": "任务空间沙盒隔离 (Space isolation)",
              "kind": "boolean",
              "hint": "默认关闭：使用磁盘持久化 Profile，任务中登录的账号跨电脑重启永久保留；开启后使用内存临时沙盒隔离，任务结束不落盘。"
            },
            {
              "path": [
                "idleTimeoutMin"
              ],
              "label": "空闲自动回收 (Idle auto-stop, minutes)",
              "kind": "number",
              "hint": "N 分钟没有任何 bcdp_* 调用后自动关闭后台浏览器进程（0 = 关闭此功能）。下次调用会自动冷启动（约 2-4 秒）。观察窗正在观看不算活动。"
            },
            {
              "path": [
                "chromePath"
              ],
              "label": "Browser binary path",
              "kind": "text",
              "hint": "Path to the Chrome/Chromium/Edge binary. Empty = auto-detect."
            },
            {
              "path": [
                "captureBackend"
              ],
              "label": "Capture backend",
              "kind": "select",
              "options": [
                {
                  "value": "auto",
                  "label": "Auto"
                },
                {
                  "value": "cdp",
                  "label": "CDP"
                },
                {
                  "value": "ffmpeg",
                  "label": "FFmpeg"
                }
              ]
            },
            {
              "path": [
                "streamProfile"
              ],
              "label": "Quality profile",
              "kind": "select",
              "options": [
                {
                  "value": "balanced",
                  "label": "Balanced"
                },
                {
                  "value": "quality",
                  "label": "Quality"
                },
                {
                  "value": "speed",
                  "label": "Speed"
                }
              ]
            },
            {
              "path": [
                "ffmpegPath"
              ],
              "label": "FFmpeg binary path",
              "kind": "text",
              "hint": "Path to ffmpeg. Empty = auto-detect / on-demand install."
            }
          ]
        }
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/drscrewdriver/dsh-browser-cdp"
  },
  "compat": {
    "hosts": [
      "dsh-tui"
    ]
  }
}