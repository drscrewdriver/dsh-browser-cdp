{
  "name": "dsh-browser-cdp",
  "version": "1.9.16",
  "description": "dsh-browser-cdp: visible agent browser for DSH — drives the vendored ego-compatible Chromium over CDP, and can also attach to a running Chrome/Edge/Brave or route through egolite, Tabbit and Lightpanda backends. 35 structured bcdp_* tools; only bcdp_status stays resident by default (lazy injection, −91.9% schema per turn for non-browser sessions). Realtime watch panel with direct click/scroll/IME input, element picks quoted into the composer, human-verification notices; non-CDP channels sync frames by 3s polling. Web shell: floating watch ball without dsh-better-sidebar, sidebar tab with it. Headless/TUI hosts: tools-only. [DSH 0.1.7-rc.1 ~ 0.2.2-rc.1 (exact rc enumeration): declarative settings via Config .volatile() fields; for DSH 0.1.2-rc.1 ~ 0.1.5-rc.3 use the 0.17.x line]",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "runtime/",
    "locale/",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.it.md",
    "README.ru.md",
    "CHANGELOG.md",
    "CHANGELOG.de.md",
    "CHANGELOG.es.md",
    "CHANGELOG.fr.md",
    "CHANGELOG.it.md",
    "CHANGELOG.ru.md",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.map"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "compatible",
        "0.2.1-rc.5 || 0.2.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "@types/ws": "^8.5.10",
    "jsdom": "^26.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-browser-cdp.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "dsh-0.2.1"
  }
}
